# Copy to .env and fill in. Never commit .env.

# The Google Drive folder ID (the part after /folders/ in the folder's URL).
FOLDER_ID=

# OAuth "Desktop app" client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From: node scripts/get-refresh-token.js
GOOGLE_REFRESH_TOKEN=

# The address guests open, no trailing slash. Add http://localhost:8080 (comma-separated) to test locally.
PUBLIC_ORIGIN=https://photos.example.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
TUNNEL_TOKEN=

PORT=8080

# Slideshow (?page=show): hold new uploads back this many minutes before they
# appear on the reception screen, so there is time to hide anything unwanted.
# 0 = show straight away.
SHOW_DELAY_MINUTES=5

# Optional: lets the slideshow play videos of any size. Without it, only videos
# under ~100 MB play; bigger ones show their still picture.
# Google Cloud Console → APIs & Services → Credentials → Create credentials → API key.
# Then edit the key: API restrictions → Google Drive API only;
# Application restrictions → Websites → your PUBLIC_ORIGIN host (e.g. photos.example.com/*).
# This key is sent to the page, so it must be restricted like that.
GOOGLE_API_KEY=
